generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cotacao", "public"]
}

// =====================
// Public (CRM)
// =====================

model Lead {
  id                 String    @id @default(uuid()) @db.Uuid
  nome               String
  dataEntrada        DateTime  @map("data_entrada") @db.Timestamptz(6)
  origem             String
  status             String
  valorComissao      Decimal?  @map("valor_comissao") // removido @db.Numeric
  dataVenda          DateTime? @map("data_venda") @db.Timestamptz(6)
  lastChamadoAt      DateTime? @map("last_chamado_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  estado             String?   @db.Text
  cidade             String?   @db.Text
  qtdVidas           Int       @map("qtd_vidas")
  idades             String?   @db.Text
  possuiCnpj         Boolean?  @map("possui_cnpj")
  temPlanoAnterior   Boolean?  @map("tem_plano_anterior")
  operadoraAnterior  String?   @map("operadora_anterior") @db.Text
  tempoPlanoAnterior String?   @map("tempo_plano_anterior") @db.Text
  modalidade         String?   @db.Text
  operadoraOfertada  String?   @map("operadora_ofertada") @db.Text
  acomodacao         String?   @db.Text
  valorMensalidade   Decimal?  @map("valor_mensalidade") // removido @db.Numeric
  coparticipacao     String?   @db.Text
  motivoDispensa     String?   @map("motivo_dispensa") @db.Text
  telefone           String?   @db.Text
  retornarEm         DateTime? @map("retornar_em") @db.Timestamptz(6)
  tipoComissao       String    @default("interno") @map("tipo_comissao") @db.Text

  instagramConversations InstagramConversation[]

  @@map("leads")
  @@schema("public")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  email       String
  name        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role     Role    @default(VENDEDOR)
  approved Boolean @default(false)

  planCommissions PlanCommission[]
  whatsappMessagesSent WhatsAppMessage[]
  instagramMessagesSent InstagramMessage[]

  @@map("users")
  @@schema("public")
}

enum Role {
  ADMIN
  VENDEDOR
  @@schema("public")
}

// =====================
// WhatsApp (Cloud API oficial) — inbox compartilhado
// =====================

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
  @@schema("public")
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  @@schema("public")
}

model WhatsAppConversation {
  id                 String    @id @default(uuid()) @db.Uuid
  waId               String    @unique @map("wa_id") @db.Text
  contactName        String?   @map("contact_name") @db.Text
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview String?   @map("last_message_preview") @db.Text
  unreadCount        Int       @default(0) @map("unread_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages WhatsAppMessage[]

  @@map("whatsapp_conversations")
  @@schema("public")
}

model WhatsAppMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  conversation   WhatsAppConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  waMessageId  String?                @unique @map("wa_message_id") @db.Text
  direction    WhatsAppDirection
  type         String                 @default("text") @db.Text
  body         String?                @db.Text
  mediaId      String?                @map("media_id") @db.Text
  mimeType     String?                @map("mime_type") @db.Text
  filename     String?                @db.Text
  transcription String?               @db.Text
  status       WhatsAppMessageStatus  @default(SENT)
  errorMessage String?                @map("error_message") @db.Text

  sentByUserId String? @map("sent_by_user_id") @db.Uuid
  sentByUser   User?   @relation(fields: [sentByUserId], references: [id])

  timestamp DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, timestamp])
  @@map("whatsapp_messages")
  @@schema("public")
}

// =====================
// Instagram (Messenger Platform / conta comercial vinculada a uma Página) — inbox compartilhado
// =====================

enum InstagramDirection {
  INBOUND
  OUTBOUND
  @@schema("public")
}

enum InstagramMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  @@schema("public")
}

model InstagramConversation {
  id                 String    @id @default(uuid()) @db.Uuid
  igsid              String    @unique @map("igsid") @db.Text
  username           String?   @map("username") @db.Text
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview String?   @map("last_message_preview") @db.Text
  unreadCount        Int       @default(0) @map("unread_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  leadId String? @map("lead_id") @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  messages InstagramMessage[]

  @@map("instagram_conversations")
  @@schema("public")
}

model InstagramMessage {
  id             String                  @id @default(uuid()) @db.Uuid
  conversationId String                  @map("conversation_id") @db.Uuid
  conversation   InstagramConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  igMessageId  String?                  @unique @map("ig_message_id") @db.Text
  direction    InstagramDirection
  type         String                   @default("text") @db.Text
  body         String?                  @db.Text
  mediaUrl     String?                  @map("media_url") @db.Text
  mediaId      String?                  @map("media_id") @db.Text
  mimeType     String?                  @map("mime_type") @db.Text
  filename     String?                  @db.Text
  transcription String?                 @db.Text
  status       InstagramMessageStatus   @default(SENT)
  errorMessage String?                  @map("error_message") @db.Text

  sentByUserId String? @map("sent_by_user_id") @db.Uuid
  sentByUser   User?   @relation(fields: [sentByUserId], references: [id])

  timestamp DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, timestamp])
  @@map("instagram_messages")
  @@schema("public")
}

model PlanCommission {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  operadora        String   @db.Text
  comissaoInterna  Decimal  @default(100) @map("comissao_interna")
  comissaoExterna  Decimal  @default(100) @map("comissao_externa")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operadora])
  @@index([userId])
  @@map("plan_commissions")
  @@schema("public")
}

// =====================
// Cotação
// =====================

enum SegmentType {
  PF
  PME
  ADESAO
  @@schema("cotacao")
}

enum AccommodationType {
  ENFERMARIA
  APARTAMENTO
  @@schema("cotacao")
}

enum PmeAdhesionType {
  LIVRE_ADESAO
  COMPULSORIO
  @@schema("cotacao")
}

model Operator {
  id        String  @id @default(cuid())
  name      String
  ansNumber String? @db.VarChar(32) @map("ansNumber")
  active    Boolean @default(true)

  colorHex String?

  products  Product[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
  @@map("operators")
}

model Product {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  commercialName String
  segment        SegmentType

  planVariants PlanVariant[]
  rateCards    RateCard[]

  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([commercialName])
  @@schema("cotacao")
  @@map("products")
}

model PlanVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  planName     String
  coverageJson Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards RateCard[]

  @@index([productId, planName])
  @@schema("cotacao")
  @@map("plan_variants")
}

model Area {
  id   String @id @default(cuid())
  name String

  cities    City[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
  @@map("areas")
}

model City {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  name String
  uf   String @db.Char(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name, uf])
  @@index([areaId])
  @@schema("cotacao")
  @@map("cities")
}

model RateCard {
  id String @id @default(cuid())

  operatorId    String
  operator      Operator @relation(fields: [operatorId], references: [id])

  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  planVariantId String
  planVariant   PlanVariant @relation(fields: [planVariantId], references: [id])

  areaId        String
  area          Area @relation(fields: [areaId], references: [id])

  segment       SegmentType
  accommodation AccommodationType
  adhesionType  PmeAdhesionType?

  minLives Int
  maxLives Int

  pricesByAge Json

  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, segment, accommodation])
  @@index([operatorId, productId, planVariantId, areaId])
  @@index([validFrom, validTo])
  @@schema("cotacao")
  @@map("rate_cards")
}

model CoparticipationRule {
  id String @id @default(cuid())

  operatorId    String?
  productId     String?
  planVariantId String?

  areaId  String?
  segment SegmentType?

  rules Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([productId])
  @@index([planVariantId])
  @@index([areaId])
  @@schema("cotacao")
  @@map("coparticipation_rules")
}
