generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cotacao", "public"]
}

// =====================
// Public (CRM)
// =====================

model Lead {
  id                    String    @id @default(uuid()) @db.Uuid
  nome                  String
  dataEntrada           DateTime  @map("data_entrada") @db.Timestamptz(6)
  origem                String
  status                String
  valorComissao         Decimal?  @map("valor_comissao") // removido @db.Numeric
  dataVenda             DateTime? @map("data_venda") @db.Timestamptz(6)
  /// dia em que a comissão da venda cai (ou cairá) na conta — costuma ser alguns dias depois de dataVenda
  dataPagamentoComissao DateTime? @map("data_pagamento_comissao") @db.Timestamptz(6)
  lastChamadoAt         DateTime? @map("last_chamado_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  estado                String?   @db.Text
  cidade                String?   @db.Text
  qtdVidas              Int       @map("qtd_vidas")
  idades                String?   @db.Text
  possuiCnpj            Boolean?  @map("possui_cnpj")
  temPlanoAnterior      Boolean?  @map("tem_plano_anterior")
  operadoraAnterior     String?   @map("operadora_anterior") @db.Text
  tempoPlanoAnterior    String?   @map("tempo_plano_anterior") @db.Text
  modalidade            String?   @db.Text
  operadoraOfertada     String?   @map("operadora_ofertada") @db.Text
  acomodacao            String?   @db.Text
  valorMensalidade      Decimal?  @map("valor_mensalidade") // removido @db.Numeric
  coparticipacao        String?   @db.Text
  motivoDispensa        String?   @map("motivo_dispensa") @db.Text
  telefone              String?   @db.Text
  retornarEm            DateTime? @map("retornar_em") @db.Timestamptz(6)

  tags           LeadTag[]
  quizStates     WhatsAppQuizState[]
  financeEntries FinanceEntry[]

  @@map("leads")
  @@schema("public")
}

// =====================
// Etiquetas (tags) — aplicadas em qualquer quantidade a cada lead
// =====================

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Text
  color     String   @default("#6366f1") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads LeadTag[]

  @@map("tags")
  @@schema("public")
}

model LeadTag {
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tags")
  @@schema("public")
}

// =====================
// Demandas (kanban interno, estilo Jira) — usuários criam tarefas entre si
// =====================

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.Text
  description String? @db.Text
  /// coluna do kanban — string livre, igual `Lead.status` (colunas fixas no código, sem tela de configurar)
  status      String  @default("A Fazer") @db.Text
  /// "Baixa" | "Média" | "Alta" | "Urgente"
  priority    String  @default("Média") @db.Text

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate   DateTime? @map("due_date") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
  @@schema("public")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  email       String
  name        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role     Role    @default(VENDEDOR)
  approved Boolean @default(false)

  whatsappMessagesSent WhatsAppMessage[]
  tasksCreated         Task[]            @relation("TaskCreatedBy")
  tasksAssigned        Task[]            @relation("TaskAssignee")

  @@map("users")
  @@schema("public")
}

enum Role {
  ADMIN
  VENDEDOR

  @@schema("public")
}

// =====================
// WhatsApp (Cloud API oficial) — inbox compartilhado
// =====================

enum WhatsAppDirection {
  INBOUND
  OUTBOUND

  @@schema("public")
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("public")
}

model WhatsAppConversation {
  id                 String    @id @default(uuid()) @db.Uuid
  waId               String    @unique @map("wa_id") @db.Text
  contactName        String?   @map("contact_name") @db.Text
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview String?   @map("last_message_preview") @db.Text
  unreadCount        Int       @default(0) @map("unread_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages  WhatsAppMessage[]
  quizState WhatsAppQuizState?

  @@map("whatsapp_conversations")
  @@schema("public")
}

enum WhatsAppQuizStatus {
  EM_ANDAMENTO
  CONCLUIDO
  INTERROMPIDO

  @@schema("public")
}

/// Estado do quiz de qualificação disparado no primeiro contato pelo WhatsApp.
/// `answers` guarda [{ step, optionId, optionTitle, at }] — dado de saúde (LGPD):
/// nunca logar, só ler por quem já tem acesso ao inbox.
model WhatsAppQuizState {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @unique @map("conversation_id") @db.Uuid
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  leadId String? @map("lead_id") @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  status               WhatsAppQuizStatus @default(EM_ANDAMENTO)
  currentStep          String?            @map("current_step") @db.Text
  lastQuestionWamid    String?            @map("last_question_wamid") @db.Text
  lastInboundWamid     String?            @map("last_inbound_wamid") @db.Text
  invalidCount         Int                @default(0) @map("invalid_count")
  answers              Json               @default("[]")
  temPlanoAtual        Boolean?           @map("tem_plano_atual")
  necessidadePrincipal String?            @map("necessidade_principal") @db.Text

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("whatsapp_quiz_states")
  @@schema("public")
}

model WhatsAppMessage {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  waMessageId   String?               @unique @map("wa_message_id") @db.Text
  direction     WhatsAppDirection
  type          String                @default("text") @db.Text
  body          String?               @db.Text
  /// Botões oferecidos numa mensagem interativa: [{ id, title }]. Só p/ exibição no inbox.
  buttons       Json?
  mediaId       String?               @map("media_id") @db.Text
  mimeType      String?               @map("mime_type") @db.Text
  filename      String?               @db.Text
  transcription String?               @db.Text
  status        WhatsAppMessageStatus @default(SENT)
  errorMessage  String?               @map("error_message") @db.Text

  sentByUserId String? @map("sent_by_user_id") @db.Uuid
  sentByUser   User?   @relation(fields: [sentByUserId], references: [id])

  timestamp DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, timestamp])
  @@map("whatsapp_messages")
  @@schema("public")
}

/// Percentual de comissão por operadora + modalidade (PF/PME/Adesão/Empresarial).
/// Global pra equipe toda — não é mais por usuário nem por interno/externo
/// (removido a pedido do usuário em 2026-09-18).
model CommissionRate {
  id         String   @id @default(uuid()) @db.Uuid
  operadora  String   @db.Text
  modalidade String   @db.Text
  percentual Decimal  @default(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([operadora, modalidade])
  @@map("commission_rates")
  @@schema("public")
}

// =====================
// Financeiro da empresa (só ADMIN) — entradas, despesas eventuais e contas fixas
// =====================

/// Entrada de dinheiro (ex: comissão de uma venda) ou despesa eventual, lançada num dia específico.
model FinanceEntry {
  id        String   @id @default(uuid()) @db.Uuid
  /// "ENTRADA" | "DESPESA_EVENTUAL"
  tipo      String   @db.Text
  descricao String   @db.Text
  valor     Decimal  @db.Decimal(12, 2)
  data      DateTime @db.Date
  /// venda que originou a entrada (uma venda só pode ser lançada uma vez)
  leadId    String?  @unique @map("lead_id") @db.Uuid
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([data])
  @@map("finance_entries")
  @@schema("public")
}

/// Conta fixa mensal (aluguel, ferramentas...). Vale em todo mês de `inicio` até `fim` (ambos "YYYY-MM"; fim nulo = em aberto).
model FinanceFixedCost {
  id            String   @id @default(uuid()) @db.Uuid
  descricao     String   @db.Text
  valor         Decimal  @db.Decimal(12, 2)
  diaVencimento Int      @map("dia_vencimento")
  inicio        String   @db.Text
  fim           String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("finance_fixed_costs")
  @@schema("public")
}

// =====================
// Cotação
// =====================

enum SegmentType {
  PF
  PME
  ADESAO

  @@schema("cotacao")
}

enum AccommodationType {
  ENFERMARIA
  APARTAMENTO

  @@schema("cotacao")
}

enum PmeAdhesionType {
  LIVRE_ADESAO
  COMPULSORIO

  @@schema("cotacao")
}

model Operator {
  id        String  @id @default(cuid())
  name      String
  ansNumber String? @map("ansNumber") @db.VarChar(32)
  active    Boolean @default(true)

  colorHex String?

  products  Product[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("operators")
  @@schema("cotacao")
}

model Product {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  commercialName String
  segment        SegmentType

  planVariants PlanVariant[]
  rateCards    RateCard[]

  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([commercialName])
  @@map("products")
  @@schema("cotacao")
}

model PlanVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  planName     String
  coverageJson Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards RateCard[]

  @@index([productId, planName])
  @@map("plan_variants")
  @@schema("cotacao")
}

model Area {
  id   String @id @default(cuid())
  name String

  cities    City[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("areas")
  @@schema("cotacao")
}

model City {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  name String
  uf   String @db.Char(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name, uf])
  @@index([areaId])
  @@map("cities")
  @@schema("cotacao")
}

model RateCard {
  id String @id @default(cuid())

  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  planVariantId String
  planVariant   PlanVariant @relation(fields: [planVariantId], references: [id])

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  segment       SegmentType
  accommodation AccommodationType
  adhesionType  PmeAdhesionType?

  minLives Int
  maxLives Int

  pricesByAge Json

  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, segment, accommodation])
  @@index([operatorId, productId, planVariantId, areaId])
  @@index([validFrom, validTo])
  @@map("rate_cards")
  @@schema("cotacao")
}

model CoparticipationRule {
  id String @id @default(cuid())

  operatorId    String?
  productId     String?
  planVariantId String?

  areaId  String?
  segment SegmentType?

  rules Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([productId])
  @@index([planVariantId])
  @@index([areaId])
  @@map("coparticipation_rules")
  @@schema("cotacao")
}
