generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// =====================
// Public (CRM)
// =====================

model Lead {
  id                    String    @id @default(uuid()) @db.Uuid
  nome                  String
  dataEntrada           DateTime  @map("data_entrada") @db.Timestamptz(6)
  origem                String
  status                String
  valorComissao         Decimal?  @map("valor_comissao") // removido @db.Numeric
  dataVenda             DateTime? @map("data_venda") @db.Timestamptz(6)
  /// dia em que a comissão da venda cai (ou cairá) na conta — costuma ser alguns dias depois de dataVenda
  dataPagamentoComissao DateTime? @map("data_pagamento_comissao") @db.Timestamptz(6)
  lastChamadoAt         DateTime? @map("last_chamado_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  estado                String?   @db.Text
  cidade                String?   @db.Text
  qtdVidas              Int       @map("qtd_vidas")
  idades                String?   @db.Text
  possuiCnpj            Boolean?  @map("possui_cnpj")
  temPlanoAnterior      Boolean?  @map("tem_plano_anterior")
  operadoraAnterior     String?   @map("operadora_anterior") @db.Text
  tempoPlanoAnterior    String?   @map("tempo_plano_anterior") @db.Text
  modalidade            String?   @db.Text
  operadoraOfertada     String?   @map("operadora_ofertada") @db.Text
  acomodacao            String?   @db.Text
  valorMensalidade      Decimal?  @map("valor_mensalidade") // removido @db.Numeric
  coparticipacao        String?   @db.Text
  motivoDispensa        String?   @map("motivo_dispensa") @db.Text
  telefone              String?   @db.Text
  retornarEm            DateTime? @map("retornar_em") @db.Timestamptz(6)

  tags           LeadTag[]
  quizStates     WhatsAppQuizState[]
  financeEntries FinanceEntry[]
  cotacoes       Cotacao[]

  @@map("leads")
  @@schema("public")
}

// =====================
// Etiquetas (tags) — aplicadas em qualquer quantidade a cada lead
// =====================

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Text
  color     String   @default("#6366f1") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads LeadTag[]

  @@map("tags")
  @@schema("public")
}

model LeadTag {
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tags")
  @@schema("public")
}

// =====================
// Demandas (kanban interno, estilo Jira) — usuários criam tarefas entre si
// =====================

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.Text
  description String? @db.Text
  /// coluna do kanban — string livre, igual `Lead.status` (colunas fixas no código, sem tela de configurar)
  status      String  @default("A Fazer") @db.Text
  /// "Baixa" | "Média" | "Alta" | "Urgente"
  priority    String  @default("Média") @db.Text

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate   DateTime? @map("due_date") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
  @@schema("public")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  email       String
  name        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role     Role    @default(VENDEDOR)
  approved Boolean @default(false)

  whatsappMessagesSent WhatsAppMessage[]
  tasksCreated         Task[]            @relation("TaskCreatedBy")
  tasksAssigned        Task[]            @relation("TaskAssignee")
  cotacoes             Cotacao[]

  @@map("users")
  @@schema("public")
}

enum Role {
  ADMIN
  VENDEDOR

  @@schema("public")
}

// =====================
// WhatsApp (Cloud API oficial) — inbox compartilhado
// =====================

enum WhatsAppDirection {
  INBOUND
  OUTBOUND

  @@schema("public")
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("public")
}

model WhatsAppConversation {
  id                 String    @id @default(uuid()) @db.Uuid
  waId               String    @unique @map("wa_id") @db.Text
  contactName        String?   @map("contact_name") @db.Text
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview String?   @map("last_message_preview") @db.Text
  unreadCount        Int       @default(0) @map("unread_count")
  /// Etiqueta fixa de follow-up: começa em 0, só aumenta (nunca é removida)
  followUpCount      Int       @default(0) @map("follow_up_count")
  /// Observações internas da equipe sobre a conversa (texto livre)
  notes              String?   @db.Text
  /// Click-to-WhatsApp: dados do anúncio de onde o contato veio (bloco "referral" do webhook da Meta)
  adReferral         Json?     @map("ad_referral")
  /// id do anúncio (referral.source_id) — indexado pra contar conversas por anúncio
  adSourceId         String?   @map("ad_source_id") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages  WhatsAppMessage[]
  quizState WhatsAppQuizState?

  @@index([adSourceId])
  @@map("whatsapp_conversations")
  @@schema("public")
}

enum WhatsAppQuizStatus {
  EM_ANDAMENTO
  CONCLUIDO
  INTERROMPIDO

  @@schema("public")
}

/// Estado do quiz de qualificação disparado no primeiro contato pelo WhatsApp.
/// `answers` guarda [{ step, optionId, optionTitle, at }] — dado de saúde (LGPD):
/// nunca logar, só ler por quem já tem acesso ao inbox.
model WhatsAppQuizState {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @unique @map("conversation_id") @db.Uuid
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  leadId String? @map("lead_id") @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  status               WhatsAppQuizStatus @default(EM_ANDAMENTO)
  currentStep          String?            @map("current_step") @db.Text
  lastQuestionWamid    String?            @map("last_question_wamid") @db.Text
  lastInboundWamid     String?            @map("last_inbound_wamid") @db.Text
  invalidCount         Int                @default(0) @map("invalid_count")
  answers              Json               @default("[]")
  temPlanoAtual        Boolean?           @map("tem_plano_atual")
  necessidadePrincipal String?            @map("necessidade_principal") @db.Text

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("whatsapp_quiz_states")
  @@schema("public")
}

model WhatsAppMessage {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  waMessageId   String?               @unique @map("wa_message_id") @db.Text
  direction     WhatsAppDirection
  type          String                @default("text") @db.Text
  body          String?               @db.Text
  /// Botões oferecidos numa mensagem interativa: [{ id, title }]. Só p/ exibição no inbox.
  buttons       Json?
  mediaId       String?               @map("media_id") @db.Text
  mimeType      String?               @map("mime_type") @db.Text
  filename      String?               @db.Text
  transcription String?               @db.Text
  status        WhatsAppMessageStatus @default(SENT)
  errorMessage  String?               @map("error_message") @db.Text

  sentByUserId String? @map("sent_by_user_id") @db.Uuid
  sentByUser   User?   @relation(fields: [sentByUserId], references: [id])

  timestamp DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, timestamp])
  @@map("whatsapp_messages")
  @@schema("public")
}

/// Percentual de comissão por operadora + modalidade (PF/PME/Adesão/Empresarial).
/// Global pra equipe toda — não é mais por usuário nem por interno/externo
/// (removido a pedido do usuário em 2026-09-18).
model CommissionRate {
  id         String   @id @default(uuid()) @db.Uuid
  operadora  String   @db.Text
  modalidade String   @db.Text
  percentual Decimal  @default(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([operadora, modalidade])
  @@map("commission_rates")
  @@schema("public")
}

// =====================
// Financeiro da empresa (só ADMIN) — entradas, despesas eventuais e contas fixas
// =====================

/// Entrada de dinheiro (ex: comissão de uma venda) ou despesa eventual, lançada num dia específico.
model FinanceEntry {
  id        String   @id @default(uuid()) @db.Uuid
  /// "ENTRADA" | "DESPESA_EVENTUAL"
  tipo      String   @db.Text
  descricao String   @db.Text
  valor     Decimal  @db.Decimal(12, 2)
  data      DateTime @db.Date
  /// venda que originou a entrada (uma venda só pode ser lançada uma vez)
  leadId    String?  @unique @map("lead_id") @db.Uuid
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([data])
  @@map("finance_entries")
  @@schema("public")
}

/// Conta fixa mensal (aluguel, ferramentas...). Vale em todo mês de `inicio` até `fim` (ambos "YYYY-MM"; fim nulo = em aberto).
model FinanceFixedCost {
  id            String   @id @default(uuid()) @db.Uuid
  descricao     String   @db.Text
  valor         Decimal  @db.Decimal(12, 2)
  diaVencimento Int      @map("dia_vencimento")
  inicio        String   @db.Text
  fim           String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("finance_fixed_costs")
  @@schema("public")
}

// =====================
// Tabelas de preço da PX Tecnologia + cotação local
// A sincronização (manual, pelo botão) baixa os produtos da PX e grava aqui;
// a cotação é calculada só com esses dados, nunca chamando a PX.
// =====================

/// Um registro por produto da PX (ex: 12 = Amil SC).
model PxProduto {
  pxId           Int      @id @map("px_id")
  nome           String   @db.Text
  operadora      String?  @db.Text
  operadoraPxId  Int?     @map("operadora_px_id")
  categoriaPxId  Int?     @map("categoria_px_id")
  visivel        Boolean  @default(true)
  /// SHA-256 do conteúdo normalizado — se não mudou, a sincronização pula o produto
  hashConteudo   String   @map("hash_conteudo") @db.Text
  sincronizadoEm DateTime @default(now()) @map("sincronizado_em") @db.Timestamptz(6)

  planos  PxPlano[]
  tabelas PxTabela[]

  @@map("px_produtos")
  @@schema("public")
}

/// Catálogo de planos de cada produto (Amil Prata, Amil S380, Black I R1...).
model PxPlano {
  produtoPxId Int     @map("produto_px_id")
  pxPlanoId   Int     @map("px_plano_id")
  nome        String  @db.Text
  codigoAns   String? @map("codigo_ans") @db.Text
  acomodacao  String? @db.Text
  abrangencia String? @db.Text

  produto PxProduto @relation(fields: [produtoPxId], references: [pxId], onDelete: Cascade)

  @@id([produtoPxId, pxPlanoId])
  @@map("px_planos")
  @@schema("public")
}

/// Cada "tabela de preço" do produto, com as regras de quem pode usá-la (tableBinds[] + valueTable).
model PxTabela {
  /// tableBinds[].id — a mesma valueTable pode, em tese, estar vinculada a vários produtos
  pxVinculoId           Int       @id @map("px_vinculo_id")
  /// tableBinds[].valueTable.id
  pxTabelaId            Int       @map("px_tabela_id")
  produtoPxId           Int       @map("produto_px_id")
  /// PME | Adesão
  modalidade            String?   @db.Text
  /// Amil | Selecionada | Black
  linha                 String?   @db.Text
  /// Parcial | Completa
  coparticipacao        String?   @db.Text
  /// ex: 40%
  coparticipacaoDetalhe String?   @map("coparticipacao_detalhe") @db.Text
  /// Compulsório | Opcional/Livre Adesão | Indiferente
  contratacao           String?   @db.Text
  /// true = tabela para empresas MEI
  mei                   Boolean
  obstetricia           Boolean
  idadeUnica            Boolean   @map("idade_unica")
  vidasMin              Int       @map("vidas_min")
  vidasMax              Int       @map("vidas_max")
  idadeMin              Int       @map("idade_min")
  idadeMax              Int       @map("idade_max")
  descontoPercentual    Decimal   @default(0) @map("desconto_percentual") @db.Decimal(6, 2)
  /// ex: Supermed (Adesão)
  administradora        String?   @db.Text
  /// entidades de classe (Adesão)
  entidades             Json      @default("[]")
  vigenciaInicio        DateTime? @map("vigencia_inicio") @db.Timestamptz(6)
  vigenciaFim           DateTime? @map("vigencia_fim") @db.Timestamptz(6)
  visivel               Boolean   @default(true)
  ordem                 Int       @default(0)
  /// problemas encontrados nos dados da PX (faixa de vidas inválida, preço zerado, buraco nas faixas...)
  inconsistencias       Json      @default("[]")

  produto PxProduto @relation(fields: [produtoPxId], references: [pxId], onDelete: Cascade)
  precos  PxPreco[]

  @@index([produtoPxId])
  @@index([modalidade, mei, vidasMin])
  @@map("px_tabelas")
  @@schema("public")
}

/// Preço de cada plano, em cada tabela, em cada faixa etária.
model PxPreco {
  pxVinculoId  Int     @map("px_vinculo_id")
  pxPlanoId    Int     @map("px_plano_id")
  planoNome    String  @map("plano_nome") @db.Text
  acomodacao   String? @db.Text
  planoVisivel Boolean @default(true) @map("plano_visivel")
  planoOrdem   Int     @default(0) @map("plano_ordem")
  /// 1 a 10 (faixas da ANS)
  faixaId      Int     @map("faixa_id")
  idadeMin     Int     @map("idade_min")
  idadeMax     Int     @map("idade_max")
  valor        Decimal @db.Decimal(10, 2)

  tabela PxTabela @relation(fields: [pxVinculoId], references: [pxVinculoId], onDelete: Cascade)

  @@id([pxVinculoId, pxPlanoId, faixaId])
  @@map("px_precos")
  @@schema("public")
}

/// Histórico de execuções da sincronização (não há alerta: o resultado fica aqui e na tela).
model PxSyncLog {
  id           Int      @id @default(autoincrement())
  iniciadoEm   DateTime @map("iniciado_em") @db.Timestamptz(6)
  finalizadoEm DateTime @map("finalizado_em") @db.Timestamptz(6)
  /// ok | com_erros
  status       String   @db.Text
  detalhes     Json

  @@map("px_sync_log")
  @@schema("public")
}

/// Cotação gerada no sistema. `resultado` guarda uma CÓPIA dos preços usados,
/// pra cotação não mudar quando a tabela for reajustada.
model Cotacao {
  id          String   @id @default(uuid()) @db.Uuid
  /// opcional: dá pra cotar sem lead e vincular depois
  leadId      String?  @map("lead_id") @db.Uuid
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  criadoPorId String?  @map("criado_por_id") @db.Uuid
  criadoPor   User?    @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  entrada     Json
  resultado   Json
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([leadId])
  @@map("cotacoes")
  @@schema("public")
}
