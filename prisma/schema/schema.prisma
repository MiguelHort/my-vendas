generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cotacao", "public"]
}

// =====================
// Public (CRM)
// =====================

model Lead {
  id                 String    @id @default(uuid()) @db.Uuid
  nome               String
  dataEntrada        DateTime  @map("data_entrada") @db.Timestamptz(6)
  origem             String
  status             String
  valorComissao      Decimal?  @map("valor_comissao") // removido @db.Numeric
  dataVenda          DateTime? @map("data_venda") @db.Timestamptz(6)
  lastChamadoAt      DateTime? @map("last_chamado_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  estado             String?   @db.Text
  cidade             String?   @db.Text
  qtdVidas           Int       @map("qtd_vidas")
  idades             String?   @db.Text
  possuiCnpj         Boolean?  @map("possui_cnpj")
  temPlanoAnterior   Boolean?  @map("tem_plano_anterior")
  operadoraAnterior  String?   @map("operadora_anterior") @db.Text
  tempoPlanoAnterior String?   @map("tempo_plano_anterior") @db.Text
  modalidade         String?   @db.Text
  operadoraOfertada  String?   @map("operadora_ofertada") @db.Text
  acomodacao         String?   @db.Text
  valorMensalidade   Decimal?  @map("valor_mensalidade") // removido @db.Numeric
  coparticipacao     String?   @db.Text
  motivoDispensa     String?   @map("motivo_dispensa") @db.Text
  telefone           String?   @db.Text
  retornarEm         DateTime? @map("retornar_em") @db.Timestamptz(6)
  tipoComissao       String    @default("interno") @map("tipo_comissao") @db.Text

  @@map("leads")
  @@schema("public")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  email       String
  name        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role     Role    @default(VENDEDOR)
  approved Boolean @default(false)

  planCommissions PlanCommission[]

  @@map("users")
  @@schema("public")
}

enum Role {
  ADMIN
  VENDEDOR
  @@schema("public")
}

model PlanCommission {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  operadora        String   @db.Text
  comissaoInterna  Decimal  @default(100) @map("comissao_interna")
  comissaoExterna  Decimal  @default(100) @map("comissao_externa")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operadora])
  @@index([userId])
  @@map("plan_commissions")
  @@schema("public")
}

// =====================
// Cotação
// =====================

enum SegmentType {
  PF
  PME
  ADESAO
  @@schema("cotacao")
}

enum AccommodationType {
  ENFERMARIA
  APARTAMENTO
  @@schema("cotacao")
}

enum PmeAdhesionType {
  LIVRE_ADESAO
  COMPULSORIO
  @@schema("cotacao")
}

model Operator {
  id        String  @id @default(cuid())
  name      String
  ansNumber String? @db.VarChar(32) @map("ansNumber")
  active    Boolean @default(true)

  colorHex String?

  products  Product[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
  @@map("operators")
}

model Product {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  commercialName String
  segment        SegmentType

  planVariants PlanVariant[]
  rateCards    RateCard[]

  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([commercialName])
  @@schema("cotacao")
  @@map("products")
}

model PlanVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  planName     String
  coverageJson Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards RateCard[]

  @@index([productId, planName])
  @@schema("cotacao")
  @@map("plan_variants")
}

model Area {
  id   String @id @default(cuid())
  name String

  cities    City[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
  @@map("areas")
}

model City {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  name String
  uf   String @db.Char(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name, uf])
  @@index([areaId])
  @@schema("cotacao")
  @@map("cities")
}

model RateCard {
  id String @id @default(cuid())

  operatorId    String
  operator      Operator @relation(fields: [operatorId], references: [id])

  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  planVariantId String
  planVariant   PlanVariant @relation(fields: [planVariantId], references: [id])

  areaId        String
  area          Area @relation(fields: [areaId], references: [id])

  segment       SegmentType
  accommodation AccommodationType
  adhesionType  PmeAdhesionType?

  minLives Int
  maxLives Int

  pricesByAge Json

  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, segment, accommodation])
  @@index([operatorId, productId, planVariantId, areaId])
  @@index([validFrom, validTo])
  @@schema("cotacao")
  @@map("rate_cards")
}

model CoparticipationRule {
  id String @id @default(cuid())

  operatorId    String?
  productId     String?
  planVariantId String?

  areaId  String?
  segment SegmentType?

  rules Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([productId])
  @@index([planVariantId])
  @@index([areaId])
  @@schema("cotacao")
  @@map("coparticipation_rules")
}
