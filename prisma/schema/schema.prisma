generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cotacao", "public"]
}

// =====================
// Public (CRM)
// =====================

model Lead {
  id                 String    @id @default(uuid()) @db.Uuid
  nome               String
  dataEntrada        DateTime  @map("data_entrada") @db.Timestamptz(6)
  origem             String
  status             String
  valorComissao      Decimal?  @map("valor_comissao") // removido @db.Numeric
  dataVenda          DateTime? @map("data_venda") @db.Timestamptz(6)
  userId             String    @map("user_id") @db.Uuid
  lastChamadoAt      DateTime? @map("last_chamado_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  estado             String?   @db.Text
  loteProducaoId     String?   @map("lote_producao_id") @db.Uuid
  cidade             String?   @db.Text
  qtdVidas           Int       @map("qtd_vidas")
  idades             String?   @db.Text
  possuiCnpj         Boolean?  @map("possui_cnpj")
  temPlanoAnterior   Boolean?  @map("tem_plano_anterior")
  operadoraAnterior  String?   @map("operadora_anterior") @db.Text
  tempoPlanoAnterior String?   @map("tempo_plano_anterior") @db.Text
  modalidade         String?   @db.Text
  operadoraOfertada  String?   @map("operadora_ofertada") @db.Text
  acomodacao         String?   @db.Text
  valorMensalidade   Decimal?  @map("valor_mensalidade") // removido @db.Numeric
  coparticipacao     String?   @db.Text
  motivoDispensa     String?   @map("motivo_dispensa") @db.Text
  telefone           String?   @db.Text
  cardColor          String?   @map("card_color") @db.Text
  notas              String?   @db.Text
  etiquetas          String?   @db.Text
  retornarEm         DateTime? @map("retornar_em") @db.Timestamptz(6)
  tipoComissao       String    @default("interno") @map("tipo_comissao") @db.Text

  // SDR de IA
  sdrCategoria         String?   @map("sdr_categoria") @db.VarChar(1)
  sdrScore             Int?      @map("sdr_score")
  sdrQualificationData Json?     @map("sdr_qualification_data")

  user         User?         @relation(fields: [userId], references: [id])
  loteProducao LoteProducao? @relation(fields: [loteProducaoId], references: [id])
  sdrConversation SdrConversation?

  @@index([userId])
  @@index([loteProducaoId])
  @@map("leads")
  @@schema("public")
}

model LoteProducao {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  dataAcao            DateTime @map("data_acao") @db.Timestamptz(6)
  volumeTotalChamado  Int      @map("volume_total_chamado")
  estadoRegiao        String   @map("estado_regiao") @db.Text
  observacoes         String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  qtdLigacao          Int      @map("qtd_ligacao")
  qtdLeadsNovos       Int      @map("qtd_leads_novos")
  qtdRetrabalhos      Int      @map("qtd_retrabalhos")
  qtdIndicacao        Int      @map("qtd_indicacao")
  qtdPresencial       Int      @map("qtd_presencial")

  user  User @relation(fields: [userId], references: [id])
  leads Lead[]

  @@index([userId])
  @@map("lotes_producao")
  @@schema("public")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  email       String
  name        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role     Role    @default(VENDEDOR)
  approved Boolean @default(false)

  leads           Lead[]
  lotesProducao   LoteProducao[]
  funnelColumns   FunnelColumn[]
  planCommissions PlanCommission[]

  // SDR de IA
  whatsappInstance WhatsappInstance?
  sdrConfig        SdrConfig?
  sdrConversations SdrConversation[]
  aiUsageLogs      AiUsageLog[]

  // Alertas
  alertConfig UserAlertConfig?

  @@map("users")
  @@schema("public")
}

enum Role {
  ADMIN
  VENDEDOR
  @@schema("public")
}

model PlanCommission {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  operadora        String   @db.Text
  comissaoInterna  Decimal  @default(100) @map("comissao_interna")
  comissaoExterna  Decimal  @default(100) @map("comissao_externa")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operadora])
  @@index([userId])
  @@map("plan_commissions")
  @@schema("public")
}

model FunnelColumn {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  colId     String   @map("col_id") @db.Text
  title     String   @db.Text
  color     String   @db.Text
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, colId])
  @@index([userId, position])
  @@map("funnel_columns")
  @@schema("public")
}

model UserAlertConfig {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  whatsappNumber String?  @map("whatsapp_number") @db.Text
  alertNovoLead  Boolean  @default(false) @map("alert_novo_lead")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_alert_config")
  @@schema("public")
}

// =====================
// SDR de IA
// =====================

model WhatsappInstance {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  senderId    String    @unique @map("sender_id") @db.Text
  status      String    @default("disconnected") @db.Text
  phoneNumber String?   @map("phone_number") @db.Text
  connectedAt DateTime? @map("connected_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_instances")
  @@schema("public")
}

model SdrConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  enabled              Boolean  @default(false)
  nomeAssistente       String   @default("Assistente") @map("nome_assistente") @db.Text
  saudacao             String?  @db.Text
  tom                  String   @default("formal") @db.Text
  handoffMinCategoria  String   @default("B") @map("handoff_min_categoria") @db.VarChar(1)
  followupMaxTentativas Int     @default(3) @map("followup_max_tentativas")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sdr_config")
  @@schema("public")
}

model SdrConversation {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  leadId          String?   @unique @map("lead_id") @db.Uuid
  whatsappNumber  String    @map("whatsapp_number") @db.Text
  status          String    @default("active") @db.Text
  consentAt       DateTime? @map("consent_at") @db.Timestamptz(6)
  followupCount   Int       @default(0) @map("followup_count")
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead     Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages SdrMessage[]
  aiLogs   AiUsageLog[]

  @@unique([userId, whatsappNumber])
  @@index([userId])
  @@map("sdr_conversations")
  @@schema("public")
}

model SdrMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String   @db.Text
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation SdrConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("sdr_messages")
  @@schema("public")
}

model AiUsageLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  model          String   @db.Text
  callType       String   @map("call_type") @db.Text
  tokensIn       Int?     @map("tokens_in")
  tokensOut      Int?     @map("tokens_out")
  costEstimate   Decimal? @map("cost_estimate") @db.Decimal(10, 6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation SdrConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("ai_usage_log")
  @@schema("public")
}

// =====================
// Cotação
// =====================

enum SegmentType {
  PF
  PME
  ADESAO
  @@schema("cotacao")
}

enum AccommodationType {
  ENFERMARIA
  APARTAMENTO
  @@schema("cotacao")
}

enum PmeAdhesionType {
  LIVRE_ADESAO
  COMPULSORIO
  @@schema("cotacao")
}

model Operator {
  id        String  @id @default(cuid())
  name      String
  ansNumber String? @db.VarChar(32) @map("ansNumber")
  active    Boolean @default(true)

  colorHex String?

  products  Product[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
  @@map("operators")
}

model Product {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  commercialName String
  segment        SegmentType

  planVariants PlanVariant[]
  rateCards    RateCard[]

  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([commercialName])
  @@schema("cotacao")
  @@map("products")
}

model PlanVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  planName     String
  coverageJson Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards RateCard[]

  @@index([productId, planName])
  @@schema("cotacao")
  @@map("plan_variants")
}

model Area {
  id   String @id @default(cuid())
  name String

  cities    City[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
  @@map("areas")
}

model City {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  name String
  uf   String @db.Char(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name, uf])
  @@index([areaId])
  @@schema("cotacao")
  @@map("cities")
}

model RateCard {
  id String @id @default(cuid())

  operatorId    String
  operator      Operator @relation(fields: [operatorId], references: [id])

  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  planVariantId String
  planVariant   PlanVariant @relation(fields: [planVariantId], references: [id])

  areaId        String
  area          Area @relation(fields: [areaId], references: [id])

  segment       SegmentType
  accommodation AccommodationType
  adhesionType  PmeAdhesionType?

  minLives Int
  maxLives Int

  pricesByAge Json

  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, segment, accommodation])
  @@index([operatorId, productId, planVariantId, areaId])
  @@index([validFrom, validTo])
  @@schema("cotacao")
  @@map("rate_cards")
}

model CoparticipationRule {
  id String @id @default(cuid())

  operatorId    String?
  productId     String?
  planVariantId String?

  areaId  String?
  segment SegmentType?

  rules Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([productId])
  @@index([planVariantId])
  @@index([areaId])
  @@schema("cotacao")
  @@map("coparticipation_rules")
}
