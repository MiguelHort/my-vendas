generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cotacao", "public"]
}

// =====================
// Public (CRM)
// =====================

model Lead {
  id                 String    @id @default(uuid()) @db.Uuid
  nome               String
  dataEntrada        DateTime  @map("data_entrada") @db.Timestamptz(6)
  origem             String
  status             String
  valorComissao      Decimal?  @map("valor_comissao") // removido @db.Numeric
  dataVenda          DateTime? @map("data_venda") @db.Timestamptz(6)
  userId             String    @map("user_id") @db.Uuid
  lastChamadoAt      DateTime? @map("last_chamado_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  estado             String?   @db.Text
  loteProducaoId     String?   @map("lote_producao_id") @db.Uuid
  cidade             String?   @db.Text
  qtdVidas           Int       @map("qtd_vidas")
  idades             String?   @db.Text
  possuiCnpj         Boolean?  @map("possui_cnpj")
  temPlanoAnterior   Boolean?  @map("tem_plano_anterior")
  operadoraAnterior  String?   @map("operadora_anterior") @db.Text
  tempoPlanoAnterior String?   @map("tempo_plano_anterior") @db.Text
  modalidade         String?   @db.Text
  operadoraOfertada  String?   @map("operadora_ofertada") @db.Text
  acomodacao         String?   @db.Text
  valorMensalidade   Decimal?  @map("valor_mensalidade") // removido @db.Numeric
  coparticipacao     String?   @db.Text
  motivoDispensa     String?   @map("motivo_dispensa") @db.Text
  telefone           String?   @db.Text
  cardColor          String?   @map("card_color") @db.Text
  notas              String?   @db.Text
  etiquetas          String?   @db.Text
  retornarEm         DateTime? @map("retornar_em") @db.Timestamptz(6)
  tipoComissao       String    @default("interno") @map("tipo_comissao") @db.Text

  user         User?         @relation(fields: [userId], references: [id])
  loteProducao LoteProducao? @relation(fields: [loteProducaoId], references: [id])

  @@index([userId])
  @@index([loteProducaoId])
  @@map("leads")
  @@schema("public")
}

model LoteProducao {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  dataAcao            DateTime @map("data_acao") @db.Timestamptz(6)
  volumeTotalChamado  Int      @map("volume_total_chamado")
  estadoRegiao        String   @map("estado_regiao") @db.Text
  observacoes         String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  qtdLigacao          Int      @map("qtd_ligacao")
  qtdLeadsNovos       Int      @map("qtd_leads_novos")
  qtdRetrabalhos      Int      @map("qtd_retrabalhos")
  qtdIndicacao        Int      @map("qtd_indicacao")
  qtdPresencial       Int      @map("qtd_presencial")

  user  User @relation(fields: [userId], references: [id])
  leads Lead[]

  @@index([userId])
  @@map("lotes_producao")
  @@schema("public")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  email       String
  name        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stripeCustomerId     String?  @map("stripe_customer_id") @db.Text
  stripeSubscriptionId String?  @map("stripe_subscription_id") @db.Text
  subscriptionStatus   String?  @map("subscription_status") @db.Text
  isActive             Boolean  @default(false) @map("is_active")

  admin        Boolean  @default(false) @map("admin")

  // ✅ NOVO: supervisor
  isSupervisor   Boolean @default(false) @map("is_supervisor")
  supervisorCode String? @unique @map("supervisor_code") @db.VarChar(16)

  leads           Lead[]
  lotesProducao   LoteProducao[]
  funnelColumns   FunnelColumn[]
  planCommissions PlanCommission[]
  consents        UserConsent[]

  // ✅ Relações para equipe (um supervisor tem vários corretores)
  supervisingLinks SupervisorBrokerLink[] @relation("SupervisorLinks")
  brokerLink       SupervisorBrokerLink?  @relation("BrokerLink")

  @@map("users")
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@schema("public")
}

model UserConsent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   @db.Text
  version    String   @db.Text
  acceptedAt DateTime @map("accepted_at") @db.Timestamptz(6)
  ip         String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_consents")
  @@schema("public")
}

model PlanCommission {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  operadora        String   @db.Text
  comissaoInterna  Decimal  @default(100) @map("comissao_interna")
  comissaoExterna  Decimal  @default(100) @map("comissao_externa")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operadora])
  @@index([userId])
  @@map("plan_commissions")
  @@schema("public")
}

model FunnelColumn {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  colId     String   @map("col_id") @db.Text
  title     String   @db.Text
  color     String   @db.Text
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, colId])
  @@index([userId, position])
  @@map("funnel_columns")
  @@schema("public")
}

model SupervisorBrokerLink {
  id           String @id @default(uuid()) @db.Uuid

  supervisorId String @map("supervisor_id") @db.Uuid
  brokerId     String @unique @map("broker_id") @db.Uuid

  status       SupervisorLinkStatus @default(PENDING)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedAt   DateTime? @map("rejected_at") @db.Timestamptz(6)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)

  supervisor User @relation("SupervisorLinks", fields: [supervisorId], references: [id])
  broker     User @relation("BrokerLink", fields: [brokerId], references: [id])

  @@index([supervisorId])
  @@index([status])
  @@map("supervisor_broker_links")
  @@schema("public")
}

enum SupervisorLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  @@schema("public")
}

model MemberGoal {
  id           String   @id @default(uuid()) @db.Uuid
  supervisorId String   @map("supervisor_id") @db.Uuid
  brokerId     String   @map("broker_id") @db.Uuid
  targetAmount Decimal  @map("target_amount")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([supervisorId, brokerId])
  @@map("member_goals")
  @@schema("public")
}

// =====================
// Cotação
// =====================

enum SegmentType {
  PF
  PME
  ADESAO
  @@schema("cotacao")
}

enum AccommodationType {
  ENFERMARIA
  APARTAMENTO
  @@schema("cotacao")
}

enum PmeAdhesionType {
  LIVRE_ADESAO
  COMPULSORIO
  @@schema("cotacao")
}

model Operator {
  id        String  @id @default(cuid())
  name      String
  ansNumber String? @db.VarChar(32) @map("ansNumber")
  active    Boolean @default(true)

  colorHex String?

  products  Product[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
  @@map("operators")
}

model Product {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  commercialName String
  segment        SegmentType

  planVariants PlanVariant[]
  rateCards    RateCard[]

  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([commercialName])
  @@schema("cotacao")
  @@map("products")
}

model PlanVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  planName     String
  coverageJson Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards RateCard[]

  @@index([productId, planName])
  @@schema("cotacao")
  @@map("plan_variants")
}

model Area {
  id   String @id @default(cuid())
  name String

  cities    City[]
  rateCards RateCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
  @@map("areas")
}

model City {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  name String
  uf   String @db.Char(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name, uf])
  @@index([areaId])
  @@schema("cotacao")
  @@map("cities")
}

model RateCard {
  id String @id @default(cuid())

  operatorId    String
  operator      Operator @relation(fields: [operatorId], references: [id])

  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  planVariantId String
  planVariant   PlanVariant @relation(fields: [planVariantId], references: [id])

  areaId        String
  area          Area @relation(fields: [areaId], references: [id])

  segment       SegmentType
  accommodation AccommodationType
  adhesionType  PmeAdhesionType?

  minLives Int
  maxLives Int

  pricesByAge Json

  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, segment, accommodation])
  @@index([operatorId, productId, planVariantId, areaId])
  @@index([validFrom, validTo])
  @@schema("cotacao")
  @@map("rate_cards")
}

model CoparticipationRule {
  id String @id @default(cuid())

  operatorId    String?
  productId     String?
  planVariantId String?

  areaId  String?
  segment SegmentType?

  rules Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([productId])
  @@index([planVariantId])
  @@index([areaId])
  @@schema("cotacao")
  @@map("coparticipation_rules")
}
