enum SegmentType {
  PF
  PME
  @@schema("cotacao")
}

enum AccommodationType {
  ENFERMARIA
  APARTAMENTO
  @@schema("cotacao")
}

enum PmeAdhesionType {
  LIVRE_ADESAO
  COMPULSORIO
  @@schema("cotacao")
}

enum RuleScopeType {
  OPERATOR
  PRODUCT
  PLAN_VARIANT
  @@schema("cotacao")
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  ansNumber String?  @db.VarChar(32)
  active    Boolean  @default(true)

  products                 Product[]
  coparticipationRules     CoparticipationRule[]
  waitingPeriodRules       WaitingPeriodRule[]
  requiredDocumentsRules   RequiredDocumentsRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@schema("cotacao")
}

model State {
  id   String @id @default(cuid())
  uf   String @unique @db.Char(2)

  cities     City[]
  salesAreas SalesArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("cotacao")
}

model City {
  id      String @id @default(cuid())
  stateId String
  name    String
  ibge    String? @db.VarChar(16)

  state      State            @relation(fields: [stateId], references: [id])
  areaLinks  SalesAreaCity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stateId, name])
  @@index([name])
  @@index([stateId])
  @@schema("cotacao")
}

model SalesArea {
  id      String @id @default(cuid())
  stateId String
  name    String

  state      State            @relation(fields: [stateId], references: [id])
  cities     SalesAreaCity[]
  priceTables PriceTable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stateId, name])
  @@index([stateId])
  @@schema("cotacao")
}

model SalesAreaCity {
  id         String @id @default(cuid())
  salesAreaId String
  cityId     String

  salesArea SalesArea @relation(fields: [salesAreaId], references: [id])
  city      City      @relation(fields: [cityId], references: [id])

  @@unique([salesAreaId, cityId])
  @@index([cityId])
  @@schema("cotacao")
}

model Product {
  id         String      @id @default(cuid())
  operatorId String
  name       String
  segment    SegmentType
  notes      String?

  operator    Operator     @relation(fields: [operatorId], references: [id])
  variants    PlanVariant[]
  priceTables PriceTable[]

  // rules scoped to product
  coparticipationRules   CoparticipationRule[]
  waitingPeriodRules     WaitingPeriodRule[]
  requiredDocumentsRules RequiredDocumentsRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([segment])
  @@unique([operatorId, name, segment])
  @@schema("cotacao")
}

model PlanVariant {
  id            String            @id @default(cuid())
  productId     String
  code          String            @db.VarChar(32) // ex: 100, 200, 110, 120
  accommodation AccommodationType
  ansRegister   String?           @db.VarChar(64)
  active        Boolean           @default(true)

  product     Product     @relation(fields: [productId], references: [id])
  priceTables PriceTable[]

  // rules scoped to plan variant
  coparticipationRules   CoparticipationRule[]
  waitingPeriodRules     WaitingPeriodRule[]
  requiredDocumentsRules RequiredDocumentsRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@unique([productId, code, accommodation])
  @@schema("cotacao")
}

model AgeBand {
  id       String @id @default(cuid())
  minAge   Int
  maxAge   Int?   // null = 59+ (ou "sem limite")
  label    String // "0 a 18", "59+"

  priceValues PriceTableValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([minAge, maxAge])
  @@index([minAge])
  @@schema("cotacao")
}

model PriceTable {
  id            String       @id @default(cuid())
  productId     String?
  planVariantId String
  salesAreaId   String?
  segment       SegmentType

  // PME
  pmeAdhesion   PmeAdhesionType?
  minLives      Int?
  maxLives      Int?

  // vigência
  validFrom     DateTime
  validTo       DateTime?

  sourceFile    String?      // nome do PDF/versão
  notes         String?

  product     Product?    @relation(fields: [productId], references: [id])
  planVariant PlanVariant @relation(fields: [planVariantId], references: [id])
  salesArea   SalesArea?  @relation(fields: [salesAreaId], references: [id])

  values      PriceTableValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planVariantId])
  @@index([salesAreaId])
  @@index([segment])
  @@index([validFrom, validTo])
  @@index([planVariantId, salesAreaId, segment, pmeAdhesion])
  @@schema("cotacao")
}

model PriceTableValue {
  id          String   @id @default(cuid())
  priceTableId String
  ageBandId   String

  // faixa de vidas (PF 1..1, 2..2 etc; PME 2..29, 30..99...)
  livesMin    Int
  livesMax    Int

  monthlyPrice Decimal @db.Decimal(12, 2)

  priceTable PriceTable @relation(fields: [priceTableId], references: [id])
  ageBand    AgeBand    @relation(fields: [ageBandId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priceTableId, ageBandId, livesMin, livesMax])
  @@index([priceTableId])
  @@index([ageBandId])
  @@schema("cotacao")
}

//
// REGRAS (Coparticipação / Carência / Documentos)
// O mesmo modelo serve pra regra no nível da Operadora, Produto ou Variante.
//
model CoparticipationRule {
  id        String        @id @default(cuid())
  scope     RuleScopeType
  operatorId String?
  productId  String?
  planVariantId String?

  procedure String
  percent   Decimal? @db.Decimal(5, 2)
  fixedValue Decimal? @db.Decimal(12, 2)
  ceilingPerProcedure Decimal? @db.Decimal(12, 2)
  monthlyCeiling Decimal? @db.Decimal(12, 2)
  notes     String?

  operator    Operator?   @relation(fields: [operatorId], references: [id])
  product     Product?    @relation(fields: [productId], references: [id])
  planVariant PlanVariant? @relation(fields: [planVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([operatorId])
  @@index([productId])
  @@index([planVariantId])
  @@schema("cotacao")
}

model WaitingPeriodRule {
  id        String        @id @default(cuid())
  scope     RuleScopeType
  operatorId String?
  productId  String?
  planVariantId String?

  level     String  // "1", "2", "3", "10" etc (como vier no material)
  procedure String
  days      Int
  notes     String?

  operator    Operator?    @relation(fields: [operatorId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  planVariant PlanVariant? @relation(fields: [planVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([operatorId])
  @@index([productId])
  @@index([planVariantId])
  @@schema("cotacao")
}

model RequiredDocumentsRule {
  id        String        @id @default(cuid())
  scope     RuleScopeType
  operatorId String?
  productId  String?
  planVariantId String?

  segment   SegmentType
  description String
  notes     String?

  operator    Operator?    @relation(fields: [operatorId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  planVariant PlanVariant? @relation(fields: [planVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([segment])
  @@index([operatorId])
  @@index([productId])
  @@index([planVariantId])
  @@schema("cotacao")
}
