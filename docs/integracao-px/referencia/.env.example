# Copie este arquivo para .env e preencha. Nunca coloque o .env no Git.

# Endereço base do tRPC da PX. Confirme na "Request URL" do DevTools:
# é tudo o que vem antes do nome da procedure.
PX_BASE_URL=https://www.painel.pxtecnologia.com/api/trpc

# Nome da procedure que devolve o produto completo (com tableBinds).
# Na página de um produto, é o 6º nome da lista separada por vírgulas na Request URL.
PX_PROC_PRODUTO=

# IDs dos produtos a sincronizar, separados por vírgula. O Amil SC é o 12.
PX_PRODUTOS=12

# Valor completo do header "cookie" de uma requisição logada (DevTools > Headers).
# Trate como senha.
PX_COOKIE=

# Pausa entre um produto e outro, para não sobrecarregar a PX.
PX_INTERVALO_MS=2000

# Banco do CRM (PostgreSQL)
DATABASE_URL=postgres://usuario:senha@localhost:5432/crm

# Opcional: URL de webhook (Slack, Discord, n8n, Zapier...) para receber alertas.
ALERTA_WEBHOOK_URL=
