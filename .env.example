# Variáveis da integração com a PX Tecnologia (tabelas de preço e cotação).
# Copie estas linhas pro seu .env (local) e pras variáveis de ambiente do deploy.
# Nunca coloque valores reais neste arquivo.

# Endereço base do tRPC da PX. Confirme na "Request URL" do DevTools (README, seção PX):
# é tudo o que vem antes do nome da procedure.
PX_BASE_URL=https://www.painel.pxtecnologia.com/api/trpc

# Nome da procedure que devolve o produto completo (com tableBinds).
# Na página de um produto, é o 6º nome da lista separada por vírgulas na Request URL.
PX_PROC_PRODUTO=

# IDs dos produtos a sincronizar, separados por vírgula. O Amil SC é o 12.
PX_PRODUTOS=12

# Valor completo do header "cookie" de uma requisição logada no painel da PX (DevTools > Headers).
# Trate como SENHA: fica só em variável de ambiente, nunca no código, no banco ou em log.
PX_COOKIE=

# Pausa entre um produto e outro, em milissegundos (educação com o servidor da PX).
PX_INTERVALO_MS=2000

# Faixas de vidas inválidas da PX (ex.: "30 a 29"): "excluir" (padrão) ou "tratar_como_sem_maximo".
PX_TABELAS_VIDAS_INVALIDAS=excluir
